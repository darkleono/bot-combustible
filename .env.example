# ⚙️ CONFIGURACIÓN DEL BOT DE COMBUSTIBLE
# (Renombrar este archivo a .env antes de usar)

# 📱 WHATSAPP SETTINGS
# Versión estable para evitar error 405 (Recomendada: 2, 3000, 1036784162)
WAPP_VERSION=2,3000,1036784162
WAPP_DEBUG=true

# 🌐 SERVER SETTINGS
# Puerto donde corre el bot (Debe coincidir con la IP:Puerto de tu navegador)
PORT=8088
TZ=America/Mexico_City

# 🤖 BOT IDENTITY
# Sanitiza automáticamente omitiendo comillas en el proceso
BOT_NAME=Combustible Bot
BOT_DESC="Asistente para la carga y auditoría de tickets de diesel."

# 📝 LOGGING
# Modos disponibles: silent, info, debug, verbose
LOG_LEVEL=info

# 👁️ DASHBOARD
EXPOSE_WEB_UI=true

# 📂 PERSISTENCIA
# Estas rutas son manejadas por docker-compose.yml
# AUTH: /app/bot_sessions
# DB: /app/database/db.json
