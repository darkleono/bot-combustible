{
  "DIESEL_FLOW": {
    "keywords": ["cargar", "carga", "combustible", "subir carga"],
    "options": {
      "exact": true,
      "delay": 1000,
      "typing": true
    },
    "steps": [
      {
        "type": "action",
        "actionName": "VALIDATE_USER_N8N"
      },
      {
        "type": "answer",
        "text": "📷 Por favor, envíame la *foto del ticket* con tu unidad escrita a mano:\n_Recuerda que puedes escribir la unidad debajo de la foto_",
        "capture": true,
        "actionName": "PROCESS_TICKET_N8N"
      }
    ]
  },
  "EXIT_FLOW": {
    "keywords": ["salir", "exit", "cancelar"],
    "options": {
        "exact": true
    },
    "messages": [
      "👋 *Sesión cerrada con éxito.* Has salido del flujo actual."
    ],
    "actionName": "CLEAR_STATE"
  },
  "DOC_FLOW": {
    "keywords": ["doc"],
    "options": {
        "exact": true
    },
    "messages": [
      "Puedes consultar la documentación técnica aquí:\n📄 https://builderbot.app/docs"
    ]
  }
}
