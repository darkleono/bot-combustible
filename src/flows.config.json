{
  "INICIO": {
    "keywords": ["cargar", "carga", "combustible", "subir carga"],
    "options": {
      "exact": true,
      "delay": 500,
      "typing": true
    },
    "actionName": "VALIDATE_USER_N8N",
    "steps": [
      {
        "type": "answer",
        "text": "✅ Identidad confirmada. Iniciando proceso de carga...",
        "actionName": "GOTO_FUEL_PROCESS"
      }
    ]
  },
  "PROCESO_COMBUSTIBLE": {
    "keywords": ["FUEL_PROCESS_TRIGGER_EVENT"],
    "steps": [
      {
        "type": "answer",
        "text": "📷 Por favor, envíame la *foto del ticket* con tu unidad escrita a mano:\n_Recuerda que puedes escribir la unidad debajo de la foto_",
        "capture": true,
        "actionName": "PROCESS_TICKET_N8N"
      }
    ]
  },
  "SALIDA": {
    "keywords": ["salir", "exit", "cancelar"],
    "options": {
      "exact": true
    },
    "messages": [
      "👋 *Sesión cerrada.* Has salido del proceso actual."
    ],
    "actionName": "CLEAR_STATE"
  },
  "AYUDA": {
    "keywords": ["doc"],
    "options": {
      "exact": true
    },
    "messages": [
      "📄 Documentación técnica: https://builderbot.app/docs"
    ]
  }
}
