      "parameters": {
        "jsCode": "// 1. Obtenemos el texto crudo de Gemini\nconst rawText = $node[\"Analyze an image\"].json.content.parts[0].text;\n\n// 2. Limpiamos las etiquetas ```json y ``` que estorban\nconst cleanText = rawText.replace(/```json|```/g, \"\").trim();\n\n// 3. Lo convertimos en un objeto JSON real para n8n\nreturn JSON.parse(cleanText);\n"
